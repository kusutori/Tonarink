<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Both WinUI executables contain Windows App SDK's generated public
         auto-initializer types. The compiler selects the test host's local
         initializer; suppress only this known SDK type-collision diagnostic. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="../../src/Tonarink.App/Tonarink.App.csproj" />
    <ProjectReference Include="../Tonarink.TestSupport/Tonarink.TestSupport.csproj" />
  </ItemGroup>
</Project>

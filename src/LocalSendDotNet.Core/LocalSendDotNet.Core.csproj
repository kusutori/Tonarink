<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Features>$(Features);runtime-async=on</Features>
    <AssemblyName>LocalSendDotNet.Core</AssemblyName>
    <RootNamespace>LocalSendDotNet</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LocalSendDotNet.Core</PackageId>
    <Version>0.3.0-preview.1</Version>
    <Description>A UI-independent .NET implementation of the LocalSend v2.2 protocol.</Description>
    <Authors>$(Company); LocalSendDotNet contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>localsend;file-transfer;lan;discovery;dotnet</PackageTags>
    <PackageReleaseNotes>$(RepositoryUrl)/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <!-- Ship the private shared text assembly with Core; no second NuGet package is required. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreResources</TargetsForTfmSpecificBuildOutput>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LocalSendDotNet.Resources/LocalSendDotNet.Resources.csproj" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Update="docs/core-api.md" Pack="true" PackagePath="/" />
    <None Update="docs/compatibility.md" Pack="true" PackagePath="/" />
    <None Update="docs/interop-matrix.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="IncludeCoreResources" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(Filename)' == 'LocalSendDotNet.Resources' And '%(Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
</Project>

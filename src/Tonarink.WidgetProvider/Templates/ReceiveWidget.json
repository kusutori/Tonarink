{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "speak": "${title}",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "size": "medium",
              "weight": "bolder",
              "spacing": "none"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "none",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "center",
                  "items": [
                    {
                      "type": "Image",
                      "url": "${statusIcon}",
                      "width": "14px",
                      "height": "14px",
                      "altText": "${appStatusLabel}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "center",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${appStatusLabel}",
                      "size": "small",
                      "isSubtle": true,
                      "spacing": "none",
                      "$when": "${$host.widgetSize != \"small\"}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "medium",
      "selectAction": {
        "type": "Action.Execute",
        "verb": "toggle"
      },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serverLabel}",
                  "weight": "bolder",
                  "spacing": "none"
                },
                {
                  "type": "TextBlock",
                  "text": "${serverHint}",
                  "size": "small",
                  "isSubtle": true,
                  "wrap": true,
                  "maxLines": 2,
                  "spacing": "none",
                  "$when": "${$host.widgetSize == \"large\"}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serverValue}",
                  "color": "${serverColor}",
                  "weight": "bolder",
                  "spacing": "none"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "medium",
      "$when": "${hasTransfer}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${transferTitle}",
          "weight": "bolder",
          "wrap": true,
          "maxLines": 1
        },
        {
          "type": "TextBlock",
          "text": "${transferPeer}",
          "size": "small",
          "isSubtle": true,
          "wrap": true,
          "maxLines": 1,
          "spacing": "none",
          "$when": "${$host.widgetSize != \"small\"}"
        },
        {
          "type": "TextBlock",
          "text": "${transferStatus}",
          "size": "small",
          "wrap": true,
          "maxLines": 1,
          "spacing": "small",
          "$when": "${$host.widgetSize != \"small\"}"
        },
        {
          "type": "TextBlock",
          "text": "${transferProgress}",
          "size": "small",
          "isSubtle": true,
          "spacing": "none",
          "$when": "${hasProgressBar}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${deviceCountLabel}",
      "weight": "bolder",
      "spacing": "medium",
      "$when": "${isNearby && !hasTransfer}"
    },
    {
      "type": "TextBlock",
      "text": "${historyCountLabel}",
      "weight": "bolder",
      "spacing": "medium",
      "$when": "${isHistory && !hasTransfer}"
    },
    {
      "type": "TextBlock",
      "text": "${emptyLabel}",
      "size": "small",
      "isSubtle": true,
      "spacing": "small",
      "$when": "${isNearby && !hasTransfer && !hasDevices && $host.widgetSize != \"small\"}"
    },
    {
      "type": "ColumnSet",
      "$data": "${devices}",
      "$when": "${$root.isNearby && !$root.hasTransfer && $host.widgetSize != \"small\" && (($host.widgetSize == \"medium\" && $index < 2) || ($host.widgetSize == \"large\" && $index < 4))}",
      "spacing": "small",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "Image",
              "url": "${icon}",
              "width": "22px",
              "height": "22px",
              "altText": "${alias}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${alias}",
              "wrap": true,
              "maxLines": 1,
              "spacing": "none"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${historyEmptyLabel}",
      "size": "small",
      "isSubtle": true,
      "spacing": "small",
      "$when": "${isHistory && !hasTransfer && !hasHistoryItems && $host.widgetSize != \"small\"}"
    },
    {
      "type": "Container",
      "$data": "${history}",
      "$when": "${$root.isHistory && !$root.hasTransfer && $host.widgetSize != \"small\" && (($host.widgetSize == \"medium\" && $index < 2) || ($host.widgetSize == \"large\" && $index < 4))}",
      "spacing": "small",
      "items": [
        {
          "type": "TextBlock",
          "text": "${fileName}",
          "weight": "bolder",
          "wrap": true,
          "maxLines": 1,
          "spacing": "none"
        },
        {
          "type": "TextBlock",
          "text": "${detail}",
          "size": "small",
          "isSubtle": true,
          "wrap": true,
          "maxLines": 1,
          "spacing": "none"
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "medium",
      "separator": true,
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "nearby"
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${nearbyTab}",
              "weight": "${nearbyWeight}",
              "color": "${nearbyColor}",
              "horizontalAlignment": "center",
              "spacing": "none"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "history"
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${historyTab}",
              "weight": "${historyWeight}",
              "color": "${historyColor}",
              "horizontalAlignment": "center",
              "spacing": "none"
            }
          ]
        }
      ]
    }
  ],
  "selectAction": {
    "type": "Action.Execute",
    "verb": "open"
  }
}

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Keep the normal build unpackaged; opt into MSIX with -p:TonarinkPackaged=true. -->
        <TonarinkPackaged Condition="'$(TonarinkPackaged)' == ''">false</TonarinkPackaged>
        <NativeAot Condition="'$(NativeAot)' == ''">false</NativeAot>
        <!-- Widgets add a Native AOT COM host. Keep them off the default package. -->
        <TonarinkWidgets Condition="'$(TonarinkWidgets)' == ''">false</TonarinkWidgets>
    </PropertyGroup>

    <!-- <snippet:template-shape> -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>Tonarink</AssemblyName>
        <RootNamespace>Tonarink</RootNamespace>
        <Product>Tonarink</Product>
        <Title>Tonarink</Title>
        <Description>An unofficial LocalSend protocol client for Windows.</Description>
        <Version>0.1.11</Version>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <!--
            x64 first so an unqualified `dotnet build` / F5 picks the right default on the
            majority of dev machines. ARM64 second for Snapdragon X. X86 retained for parity
            with the WinUI 3 templates even though Reactor itself is only tested on x64 / ARM64.
        -->
        <Platforms>x64;ARM64;X86</Platforms>
        <UseWinUI>true</UseWinUI>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
        <!--
            WindowsAppSDKSelfContained bundles the Windows App SDK runtime alongside the
            published exe so the app:
              (a) runs from any folder without a separate Windows App Runtime install, and
              (b) survives `dotnet watch run` hot reload (used by the Reactor Visual Studio
                  embedded-preview extension — spec 056). Incremental rebuilds otherwise
                  double-count transitive Microsoft.WindowsAppSDK.* references and trip
                  Microsoft.WindowsAppSDK.ComponentReference.targets' strict version check
                  ("version 2.0.20;2.0.20 was referenced"). Self-contained bundling
                  sidesteps that check.
            Tradeoff: ~30 MB extra in the publish output. To ship framework-dependent
            (smaller publish, requires the user to install Microsoft.WindowsAppRuntime
            separately) flip this to false and ensure your install instructions tell users
            to install the runtime first.
        -->
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ReactorLocDefaultLocale>en-US</ReactorLocDefaultLocale>
        <ReactorLocStringsPath>Strings\</ReactorLocStringsPath>
        <!-- ReswResourceProvider reads sentence-style keys directly; MakePRI must not index them. -->
        <EnableDefaultPriItems>false</EnableDefaultPriItems>
        <!--
            Auto-resolve RuntimeIdentifier from the host SDK when the caller hasn't pinned
            Platform / RuntimeIdentifier explicitly. Lets `dotnet build` / `dotnet run`
            succeed without forcing -p:Platform=x64 on every invocation — WindowsAppSDK's
            self-contained build path requires a concrete RID.
        -->
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU')">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>
    <!-- </snippet:template-shape> -->

    <PropertyGroup Condition="'$(TonarinkPackaged)' != 'true'">
        <WindowsPackageType>None</WindowsPackageType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TonarinkPackaged)' == 'true'">
        <WindowsPackageType>MSIX</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
        <GenerateAppxPackageOnBuild Condition="'$(GenerateAppxPackageOnBuild)' == ''">false</GenerateAppxPackageOnBuild>
        <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxBundle>Never</AppxBundle>
        <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
        <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
        <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
        <GenerateTestArtifacts>false</GenerateTestArtifacts>
        <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU'">x64</Platform>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(NativeAot)' == 'true'">
        <PublishAot>true</PublishAot>
        <!-- LocaleProvider/IntlAccessor construct CultureInfo(locale). zh-CN and
             en-US are required for Resw strings and must stay available. -->
        <InvariantGlobalization>false</InvariantGlobalization>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <PropertyGroup>
        <_ExplorerCommandProject>$(MSBuildThisFileDirectory)..\Tonarink.ExplorerCommand\Tonarink.ExplorerCommand.csproj</_ExplorerCommandProject>
        <_ExplorerCommandRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ExplorerCommandRid>
        <_ExplorerCommandRid Condition="'$(_ExplorerCommandRid)' == '' And ('$(Platform)' == 'ARM64' Or '$(Platform)' == 'arm64')">win-arm64</_ExplorerCommandRid>
        <_ExplorerCommandRid Condition="'$(_ExplorerCommandRid)' == ''">win-x64</_ExplorerCommandRid>
        <_ExplorerCommandPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)explorer-command\$(_ExplorerCommandRid)\'))</_ExplorerCommandPublishDir>
        <_WidgetProviderProject>$(MSBuildThisFileDirectory)..\Tonarink.WidgetProvider\Tonarink.WidgetProvider.csproj</_WidgetProviderProject>
        <_WidgetProviderRid>$(_ExplorerCommandRid)</_WidgetProviderRid>
        <_WidgetProviderPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)widget-provider\$(_WidgetProviderRid)\'))</_WidgetProviderPublishDir>
    </PropertyGroup>

    <Target Name="PublishTonarinkExplorerCommand"
            BeforeTargets="BeforeBuild;AssignTargetPaths;GetCopyToPublishDirectoryItems"
            Condition="'$(TonarinkPackaged)' == 'true' Or '$(PublishAot)' == 'true' Or '$(NativeAot)' == 'true'">
        <MSBuild
            Projects="$(_ExplorerCommandProject)"
            Targets="Restore"
            Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_ExplorerCommandRid);Platform=$(Platform)"
            RemoveProperties="Restore" />
        <MSBuild
            Projects="$(_ExplorerCommandProject)"
            Targets="Publish"
            Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_ExplorerCommandRid);Platform=$(Platform);PublishDir=$(_ExplorerCommandPublishDir);PublishAot=true;NativeLib=Shared;SelfContained=true" />
        <ItemGroup>
            <Content Include="$(_ExplorerCommandPublishDir)Tonarink.ExplorerCommand.dll"
                     Condition="Exists('$(_ExplorerCommandPublishDir)Tonarink.ExplorerCommand.dll')">
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <Link>Tonarink.ExplorerCommand.dll</Link>
            </Content>
        </ItemGroup>
    </Target>

    <Target Name="PrepareWidgetsAppxManifest"
            BeforeTargets="BeforeBuild;_CalculateInputsForGenerateCurrentProjectAppxManifest"
            Condition="'$(TonarinkWidgets)' == 'true' And '$(TonarinkPackaged)' == 'true'">
        <PropertyGroup>
            <_WidgetsManifest>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)Package.Widgets.appxmanifest'))</_WidgetsManifest>
        </PropertyGroup>
        <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Add-WidgetManifestExtensions.ps1&quot; -Source &quot;$(MSBuildThisFileDirectory)Package.appxmanifest&quot; -Destination &quot;$(_WidgetsManifest)&quot; -FragmentPath &quot;$(MSBuildThisFileDirectory)Package.Widgets.extensions.xml&quot;" />
        <ItemGroup>
            <AppxManifest Remove="Package.appxmanifest" />
            <AppxManifest Include="$(_WidgetsManifest)">
                <SubType>Designer</SubType>
            </AppxManifest>
        </ItemGroup>
    </Target>

    <Target Name="CollectWidgetProviderPayload">
        <ItemGroup>
            <_WidgetProviderPayload Remove="@(_WidgetProviderPayload)" />
            <_WidgetProviderPayload Include="$(_WidgetProviderPublishDir)Tonarink.WidgetProvider.exe">
                <TargetPath>WidgetProvider\Tonarink.WidgetProvider.exe</TargetPath>
            </_WidgetProviderPayload>
            <_WidgetProviderPayload Include="$(_WidgetProviderPublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll"
                                    Condition="Exists('$(_WidgetProviderPublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll')">
                <TargetPath>WidgetProvider\Microsoft.WindowsAppRuntime.Bootstrap.dll</TargetPath>
            </_WidgetProviderPayload>
            <_WidgetProviderPayload Include="$(_WidgetProviderPublishDir)Microsoft.WindowsAppRuntime.dll"
                                    Condition="Exists('$(_WidgetProviderPublishDir)Microsoft.WindowsAppRuntime.dll')">
                <TargetPath>WidgetProvider\Microsoft.WindowsAppRuntime.dll</TargetPath>
            </_WidgetProviderPayload>
            <_WidgetProviderPayload Include="$(_WidgetProviderPublishDir)Microsoft.Windows.Widgets.dll"
                                    Condition="Exists('$(_WidgetProviderPublishDir)Microsoft.Windows.Widgets.dll')">
                <TargetPath>WidgetProvider\Microsoft.Windows.Widgets.dll</TargetPath>
            </_WidgetProviderPayload>
            <_WidgetProviderTemplate Include="$(_WidgetProviderPublishDir)Templates\*.json" />
            <_WidgetProviderAsset Include="$(_WidgetProviderPublishDir)WidgetAssets\*.png" />
            <_WidgetProviderPayload Include="@(_WidgetProviderTemplate)">
                <TargetPath>WidgetProvider\Templates\%(Filename)%(Extension)</TargetPath>
            </_WidgetProviderPayload>
            <_WidgetProviderPayload Include="@(_WidgetProviderAsset)">
                <TargetPath>WidgetProvider\WidgetAssets\%(Filename)%(Extension)</TargetPath>
            </_WidgetProviderPayload>
        </ItemGroup>
    </Target>

    <Target Name="PublishTonarinkWidgetProvider"
            BeforeTargets="BeforeBuild;AssignTargetPaths"
            Condition="'$(TonarinkWidgets)' == 'true' And ('$(TonarinkPackaged)' == 'true' Or '$(PublishAot)' == 'true' Or '$(NativeAot)' == 'true')">
        <MSBuild
            Projects="$(_WidgetProviderProject)"
            Targets="Restore"
            Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_WidgetProviderRid);Platform=$(Platform)"
            RemoveProperties="Restore" />
        <MSBuild
            Projects="$(_WidgetProviderProject)"
            Targets="Publish"
            Properties="Configuration=$(Configuration);RuntimeIdentifier=$(_WidgetProviderRid);Platform=$(Platform);PublishDir=$(_WidgetProviderPublishDir);SelfContained=true;WindowsAppSDKSelfContained=true;WindowsPackageType=None;PublishAot=true" />
        <CallTarget Targets="CollectWidgetProviderPayload" />
        <Copy SourceFiles="@(_WidgetProviderPayload)"
              DestinationFiles="@(_WidgetProviderPayload->'$(OutDir)%(TargetPath)')"
              SkipUnchangedFiles="true" />
        <MakeDir Directories="$(OutDir)Public" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Tonarink.WidgetProvider\Public\.gitkeep"
              DestinationFolder="$(OutDir)Public"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyTonarinkWidgetProviderToPublish"
            AfterTargets="Publish"
            Condition="'$(TonarinkWidgets)' == 'true' And ('$(TonarinkPackaged)' == 'true' Or '$(PublishAot)' == 'true' Or '$(NativeAot)' == 'true')">
        <CallTarget Targets="CollectWidgetProviderPayload" />
        <Copy SourceFiles="@(_WidgetProviderPayload)"
              DestinationFiles="@(_WidgetProviderPayload->'$(PublishDir)%(TargetPath)')"
              SkipUnchangedFiles="true" />
        <MakeDir Directories="$(PublishDir)Public" />
        <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Tonarink.WidgetProvider\Public\.gitkeep"
              DestinationFolder="$(PublishDir)Public"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="AddWidgetProviderAppxPayload"
            BeforeTargets="_ComputeAppxPackagePayload"
            DependsOnTargets="PublishTonarinkWidgetProvider;CollectWidgetProviderPayload"
            Condition="'$(TonarinkWidgets)' == 'true' And '$(TonarinkPackaged)' == 'true'">
        <ItemGroup>
            <AppxPackagePayload Include="@(_WidgetProviderPayload)">
                <TargetPath>%(TargetPath)</TargetPath>
            </AppxPackagePayload>
            <AppxPackagePayload Include="$(MSBuildThisFileDirectory)..\Tonarink.WidgetProvider\Public\.gitkeep">
                <TargetPath>Public\.gitkeep</TargetPath>
            </AppxPackagePayload>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
        <PackageReference Include="LottieGen.MsBuild"
                          GeneratePathProperty="true"
                          PrivateAssets="all" />
        <PackageReference Include="Microsoft.Graphics.Win2D" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Runtime"
                          GeneratePathProperty="true"
                          PrivateAssets="all" />
        <PackageReference Include="Microsoft.UI.Reactor" />
        <PackageReference Include="WinUIEx" />
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" />
        <ProjectReference Include="..\LocalSendDotNet.Core\LocalSendDotNet.Core.csproj" />
    </ItemGroup>

    <!-- Windows App SDK 2.4's self-contained payload omits this aggregate-runtime
         resource even though AppNotificationManager.Register still loads it.
         Extract the architecture-matched copy from the SDK runtime MSIX until the
         upstream missing-resource fix ships in a stable SDK release. -->
    <PropertyGroup>
        <_WinAppRuntimeArchitecture>x64</_WinAppRuntimeArchitecture>
        <_WinAppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(Platform)' == 'X86' Or '$(Platform)' == 'x86'">x86</_WinAppRuntimeArchitecture>
        <_WinAppRuntimeArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(Platform)' == 'ARM64' Or '$(Platform)' == 'arm64'">arm64</_WinAppRuntimeArchitecture>
        <_WinAppRuntimeMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-$(_WinAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.2.msix</_WinAppRuntimeMsix>
        <_WinAppRuntimeInsightsResource>$(BaseIntermediateOutputPath)winappruntime\$(_WinAppRuntimeArchitecture)\Microsoft.WindowsAppRuntime.Insights.Resource.dll</_WinAppRuntimeInsightsResource>
    </PropertyGroup>

    <Target Name="_PrepareWinAppRuntimeInsightsResource"
            BeforeTargets="AssignTargetPaths"
            Inputs="$(_WinAppRuntimeMsix)"
            Outputs="$(_WinAppRuntimeInsightsResource)"
            Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
        <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Extract-ZipEntry.ps1&quot; -Source &quot;$(_WinAppRuntimeMsix)&quot; -Entry &quot;Microsoft.WindowsAppRuntime.Insights.Resource.dll&quot; -Destination &quot;$(_WinAppRuntimeInsightsResource)&quot;" />
    </Target>

    <ItemGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
        <Content Include="$(_WinAppRuntimeInsightsResource)">
            <Link>Microsoft.WindowsAppRuntime.Insights.Resource.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <!-- ReswResourceProvider reads the source .resw files at runtime. -->
    <ItemGroup>
        <PRIResource Remove="Strings\**\*.resw" />
        <None Include="Strings\**\*.resw"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="Assets\AppIcon.svg" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\FileDrop.svg"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <_LottieGeneratedCodeDirectory>$(BaseIntermediateOutputPath)$(Configuration)\$(Platform)\Lottie\</_LottieGeneratedCodeDirectory>
    </PropertyGroup>

    <ItemGroup>
        <LottieAnimation Include="Assets\IdleLogo.json" />
        <LottieAnimation Include="Assets\SplashLogo.json" />
        <LottieAnimation Include="Search\SearchingDevices.json" />
    </ItemGroup>

    <Target Name="_GenerateLottieSources"
            Inputs="@(LottieAnimation)"
            Outputs="@(LottieAnimation->'$(_LottieGeneratedCodeDirectory)%(Filename).cs')">
        <MakeDir Directories="$(_LottieGeneratedCodeDirectory)" />
        <LottieGen.Task.LottieGen
            InputFile="%(LottieAnimation.FullPath)"
            Language="cs"
            Namespace="Tonarink"
            OutputFolder="$(_LottieGeneratedCodeDirectory)"
            Public="true"
            WinUIVersion="3.0" />
    </Target>

    <!-- LottieGen 8.2 does not mark its WinRT interface implementers partial,
         which CsWinRT requires for trimming and Native AOT. Keep this automatic
         and incremental so no checked-in generated source or manual script is needed. -->
    <Target Name="_PrepareGeneratedLottieSourcesForAot"
            DependsOnTargets="_GenerateLottieSources"
            Inputs="@(LottieAnimation->'$(_LottieGeneratedCodeDirectory)%(Filename).cs')"
            Outputs="@(LottieAnimation->'$(_LottieGeneratedCodeDirectory)%(Filename).partial.stamp')">
        <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$path = '$(_LottieGeneratedCodeDirectory)%(LottieAnimation.Filename).cs'; $text = [IO.File]::ReadAllText($path); $text = $text.Replace('sealed class ', 'sealed partial class '); [IO.File]::WriteAllText($path, $text, (New-Object Text.UTF8Encoding($false)))&quot;" />
        <Touch Files="$(_LottieGeneratedCodeDirectory)%(LottieAnimation.Filename).partial.stamp"
               AlwaysCreate="true" />
    </Target>

    <Target Name="_IncludeGeneratedLottieSources"
            BeforeTargets="CoreCompile"
            DependsOnTargets="_PrepareGeneratedLottieSourcesForAot">
        <ItemGroup>
            <Compile Include="@(LottieAnimation->'$(_LottieGeneratedCodeDirectory)%(Filename).cs')" />
        </ItemGroup>
    </Target>

    <!-- The package predates SDK-style WinUI and places its registration under
         build/win, which NuGet does not auto-import for net*-windows projects. -->
    <Import Project="$(PkgLottieGen_MsBuild)\build\win\LottieGen.MsBuild.props"
            Condition="Exists('$(PkgLottieGen_MsBuild)\build\win\LottieGen.MsBuild.props')" />

    <ItemGroup Condition="'$(TonarinkPackaged)' == 'true'">
        <AppxManifest Include="Package.appxmanifest">
            <SubType>Designer</SubType>
        </AppxManifest>
        <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
        <PRIResource Include="Assets\*.png" />
    </ItemGroup>

    <!--
        Windows App SDK currently leaves generated MRT/XAML resources in the build
        output for unpackaged Native AOT publishes. Copy them beside the native exe
        so WinUI can initialize its resource manager at runtime.
    -->
    <Target Name="_CopyWinUIResourcesForAot" AfterTargets="Publish"
            Condition="'$(PublishAot)' == 'true' And '$(AppxPackage)' != 'true'">
        <ItemGroup>
            <_WinUIResourcesForAot Include="$(OutputPath)**\*.xbf" />
            <_WinUIResourcesForAot Include="$(OutputPath)$(AssemblyName).pri"
                                   Condition="Exists('$(OutputPath)$(AssemblyName).pri')" />
        </ItemGroup>
        <Copy SourceFiles="@(_WinUIResourcesForAot)"
              DestinationFiles="@(_WinUIResourcesForAot->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <!--
        Debug-only: enable the Reactor devtools surface so the *devtools* flag
        (from Properties/launchSettings.json's default F5 args) lights up the
        devtools menu, and so the Visual Studio embedded-preview extension's
        embed-host activation (which requires devtools support) succeeds.
        Release / Publish builds drop both the package and the host-config
        switch so the trim / AOT analyzers stay happy (see
        docs/guide/packaging.md, section "Keep Reactor.DevtoolsSupport out of
        retail"). To enable devtools in Release as well, move these into the
        unconditioned ItemGroup above.
    -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.UI.Reactor.Devtools" />
        <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
    </ItemGroup>

</Project>

@page "/Error"
@using System.Diagnostics
@inherits Tonarink.Blazor.Shared.StatefulComponentBase

<PageTitle>@T("WebErrorTitle")</PageTitle>

<h1 class="text-danger">@T("WebErrorTitle")</h1>
<h2 class="text-danger">@T("WebErrorDescription")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@T("RequestId")</strong> <code>@RequestId</code>
    </p>
}

<h3>@T("DevelopmentMode")</h3>
<p>
    @T("DevelopmentDetails")
</p>
<p>
    <strong>@T("DevelopmentWarning")</strong>
    @T("DevelopmentInstructions")
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}

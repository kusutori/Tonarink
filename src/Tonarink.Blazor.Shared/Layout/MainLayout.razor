@inherits StatefulComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IThemeService ThemeService

<FluentLayout Class="app-shell" Width="100%" Height="100vh" MobileBreakdownWidth="768" GlobalScrollbar="false">
    <FluentLayoutItem Area="LayoutArea.Header" Class="app-titlebar" Height="52px" Padding="Padding.All0">
        <FluentLayoutHamburger Display="HamburgerDisplay.MobileOnly"
                               IconTitle="@T("Navigate")"
                               PanelHeader="Tonarink"
                               PanelSize="DialogSize.Small" />
        <img class="brand-mark" src="_content/Tonarink.Blazor.Shared/tonarink.svg" alt="" />
        <strong>Tonarink</strong>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Class="app-navigation" Width="240px" Padding="Padding.All0">
        <div class="navigation-surface">
            <FluentNav UseIcons="true" Width="100%" aria-label="@T("Navigate")">
                <FluentNavItem Href="/" Match="NavLinkMatch.All"
                               Tooltip="@T("Receive")"
                               IconRest="@(new Icons.Regular.Size24.ArrowDownload())"
                               IconActive="@(new Icons.Filled.Size24.ArrowDownload())">
                    @T("Receive")
                </FluentNavItem>
                <FluentNavItem Href="/send"
                               Tooltip="@T("Send")"
                               IconRest="@(new Icons.Regular.Size24.Send())"
                               IconActive="@(new Icons.Filled.Size24.Send())">
                    @T("Send")
                </FluentNavItem>
                <FluentNavItem Href="/settings"
                               Tooltip="@T("Settings")"
                               IconRest="@(new Icons.Regular.Size24.Settings())"
                               IconActive="@(new Icons.Filled.Size24.Settings())">
                    @T("Settings")
                </FluentNavItem>
            </FluentNav>

            <div class="network-status @(AppState.RuntimeRunning ? "online" : "offline")">
                <FluentIcon Value="@(new Icons.Regular.Size24.Wifi1())" />
                <div>
                    <strong>@(AppState.RuntimeRunning ? T("NodeRunning") : T("NodeStopped"))</strong>
                    <small>@AppState.Settings.Alias</small>
                </div>
                <span class="status-dot" aria-hidden="true"></span>
            </div>
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="app-main" Padding="Padding.All0">
        <main class="app-content">@Body</main>
    </FluentLayoutItem>
</FluentLayout>
<FluentDialogProvider />
<FluentToastProvider />
<FluentTooltipProvider />

@code {
    [Parameter] public RenderFragment? Body { get; set; }
    private readonly HashSet<string> _notifiedOffers = [];
    private readonly HashSet<string> _notifiedTransfers = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ApplyAppThemeAsync();
    }

    protected override void OnAppStateChanged()
    {
        if (AppState.TakeRequestedRoute() is { } route) Navigation.NavigateTo(route);
        if (!AppState.Platform.Capabilities.IsNative) _ = NotifyBrowserAsync();
        _ = ApplyAppThemeAsync();
    }

    private Task ApplyAppThemeAsync() => ThemeService.SetThemeAsync(new ThemeSettings(
        "#0f8f95",
        0,
        0,
        AppState.Settings.Theme switch
        {
            TonarinkTheme.Dark => ThemeMode.Dark,
            TonarinkTheme.Light => ThemeMode.Light,
            _ => ThemeMode.System,
        },
        false));

    private async Task NotifyBrowserAsync()
    {
        try
        {
            foreach (var offer in AppState.IncomingOffers.Where(offer => _notifiedOffers.Add(offer.Id)))
                await JS.InvokeVoidAsync("tonarink.notify", T("IncomingTransfer"), T("IncomingNotifyBody", offer.SenderAlias, offer.Items.Count));
            foreach (var transfer in AppState.Transfers.Where(transfer => transfer.Status == TransferStatus.Completed && _notifiedTransfers.Add(transfer.Id)))
                await JS.InvokeVoidAsync("tonarink.notify", T("TransferCompleted"), transfer.Summary);
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
    }
}

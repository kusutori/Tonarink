@inherits StatefulComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ThemeService ThemeService

<BbSidebarProvider DefaultOpen="true" Variant="SidebarVariant.Sidebar">
    <BbSidebar>
        <BbSidebarHeader>
            <BbSidebarHeaderContent>
                <div class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">T</div>
                <BbSidebarHeaderInfo>
                    <span class="truncate font-semibold">Tonarink</span>
                    <span class="truncate text-xs text-muted-foreground">@AppState.Platform.Capabilities.PlatformName</span>
                </BbSidebarHeaderInfo>
            </BbSidebarHeaderContent>
        </BbSidebarHeader>
        <BbSidebarContent>
            <BbSidebarGroup>
                <BbSidebarGroupLabel>@L("导航", "Navigate")</BbSidebarGroupLabel>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="@L("接收", "Receive")">
                            <LucideIcon Name="inbox" Class="h-4 w-4" />
                            <span>@L("接收", "Receive")</span>
                            @if (AppState.IncomingOffers.Count > 0)
                            {
                                <BbSidebarMenuBadge>@AppState.IncomingOffers.Count</BbSidebarMenuBadge>
                            }
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/send" Tooltip="@L("发送", "Send")">
                            <LucideIcon Name="send" Class="h-4 w-4" />
                            <span>@L("发送", "Send")</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/settings" Tooltip="@L("设置", "Settings")">
                            <LucideIcon Name="settings" Class="h-4 w-4" />
                            <span>@L("设置", "Settings")</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroup>
        </BbSidebarContent>
        <BbSidebarFooter>
            <BbBadge Variant="@(AppState.RuntimeRunning ? BadgeVariant.Default : BadgeVariant.Secondary)">
                @(AppState.RuntimeRunning ? L("节点运行中", "Node running") : L("节点未运行", "Node stopped"))
            </BbBadge>
        </BbSidebarFooter>
    </BbSidebar>
    <BbSidebarInset>
        <header class="flex items-center gap-2 px-4 py-3 border-b">
            <BbSidebarTrigger />
            <BbSeparator Orientation="SeparatorOrientation.Vertical" Class="h-4" />
            <span class="text-sm text-muted-foreground">@AppState.Settings.Alias</span>
        </header>
        <div class="flex-1 overflow-auto">
            @Body
        </div>
    </BbSidebarInset>
</BbSidebarProvider>
<BbPortalHost />
<BbDialogProvider />

@code {
    [Parameter]
    public RenderFragment? Body { get; set; }

    private readonly HashSet<string> _notifiedOffers = [];
    private readonly HashSet<string> _notifiedTransfers = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        await ThemeService.InitializeAsync();
        await ApplyAppThemeAsync();
    }

    protected override void OnAppStateChanged()
    {
        if (AppState.TakeRequestedRoute() is { } route)
            Navigation.NavigateTo(route);
        if (!AppState.Platform.Capabilities.IsNative)
            _ = NotifyBrowserAsync();
        _ = ApplyAppThemeAsync();
    }

    private async Task ApplyAppThemeAsync()
    {
        var dark = AppState.Settings.Theme switch
        {
            TonarinkTheme.Dark => true,
            TonarinkTheme.Light => false,
            _ => ThemeService.IsDarkMode,
        };
        if (AppState.Settings.Theme != TonarinkTheme.System)
            await ThemeService.SetDarkModeAsync(dark);
        await ThemeService.SetPrimaryColorAsync(PrimaryColor.Teal);
    }

    private async Task NotifyBrowserAsync()
    {
        try
        {
            foreach (var offer in AppState.IncomingOffers.Where(offer => _notifiedOffers.Add(offer.Id)))
                await JS.InvokeVoidAsync("tonarink.notify", L("收到发送请求", "Incoming transfer"),
                    L($"{offer.SenderAlias} 想要发送 {offer.Items.Count} 项内容", $"{offer.SenderAlias} wants to send {offer.Items.Count} items"));
            foreach (var transfer in AppState.Transfers.Where(transfer => transfer.Status == TransferStatus.Completed && _notifiedTransfers.Add(transfer.Id)))
                await JS.InvokeVoidAsync("tonarink.notify", L("传输完成", "Transfer completed"), transfer.Summary);
        }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
    }
}

@inject IStringLocalizer<SharedResources> Loc

<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="page">
                <EmptyState Title="@Loc["PageNotFound"]"
                            Description="@Loc["PageNotFoundDescription"]">
                    <Icon><FluentIcon Value="@(new Icons.Regular.Size32.QuestionCircle())" /></Icon>
                    <ChildContent>
                        <FluentButton Appearance="ButtonAppearance.Primary" Href="/">@Loc["BackToReceivePage"]</FluentButton>
                    </ChildContent>
                </EmptyState>
            </div>
        </LayoutView>
    </NotFound>
</Router>

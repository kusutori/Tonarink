@page "/history"
@inherits StatefulComponentBase

<PageTitle>@T("History") · Tonarink</PageTitle>

<div class="page">
    <header class="page-header">
        <div>
            <h1>@T("History")</h1>
            <p>@T("HistoryDescription")</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Href="/">@T("BackToReceive")</BbButton>
    </header>

    <BbCard>
        <BbCardContent>
            @if (AppState.Transfers.Count == 0)
            {
                <BbEmpty Title="@T("NoTransfers")" Description="@T("NoTransfersHint")">
                    <Icon><LucideIcon Name="history" /></Icon>
                </BbEmpty>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var transfer in AppState.Transfers)
                    {
                        <div class="row-item">
                            <LucideIcon Name="@(transfer.Direction == TransferDirection.Send ? "arrow-up" : "arrow-down")" Class="h-4 w-4" />
                            <div>
                                <strong>@transfer.PeerAlias</strong>
                                <small>@transfer.Summary · @StatusText(transfer.Status)</small>
                                <BbProgress Value="@(transfer.Progress * 100)" />
                            </div>
                            <time class="text-xs text-muted-foreground">@transfer.UpdatedAt.ToLocalTime().ToString("g")</time>
                        </div>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    private string StatusText(TransferStatus status) => status switch
    {
        TransferStatus.Waiting => T("StatusWaiting"),
        TransferStatus.Transferring => T("StatusTransferring"),
        TransferStatus.Completed => T("StatusCompleted"),
        TransferStatus.Cancelled => T("StatusCancelled"),
        TransferStatus.Failed => T("StatusFailed"),
        _ => status.ToString(),
    };
}

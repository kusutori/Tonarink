@page "/history"
@inherits StatefulComponentBase

<PageTitle>@L("历史", "History") · Tonarink</PageTitle>
<header class="page-header"><div><span class="eyebrow">@L("传输记录", "Transfer log")</span><h1>@L("历史", "History")</h1><p>@L("当前会话中的发送和接收活动。", "Send and receive activity from this session.")</p></div></header>
<section class="panel-card full-panel">
    @if (AppState.Transfers.Count == 0)
    {
        <div class="empty-card searching"><span>◷</span><p>@L("暂无传输记录", "No transfers yet")</p></div>
    }
    else
    {
        <div class="card-list">
            @foreach (var transfer in AppState.Transfers)
            {
                <article class="history-card">
                    <div class="device-icon">@(transfer.Direction == TransferDirection.Send ? "↑" : "↓")</div>
                    <div class="history-content"><strong>@transfer.PeerAlias</strong><small>@transfer.Summary · @StatusText(transfer.Status)</small><progress value="@transfer.Progress" max="1"></progress></div>
                    <time>@transfer.UpdatedAt.ToLocalTime().ToString("g")</time>
                </article>
            }
        </div>
    }
</section>

@code {
    private string StatusText(TransferStatus status) => status switch
    {
        TransferStatus.Waiting => L("等待中", "Waiting"),
        TransferStatus.Transferring => L("传输中", "Transferring"),
        TransferStatus.Completed => L("已完成", "Completed"),
        TransferStatus.Cancelled => L("已取消", "Cancelled"),
        TransferStatus.Failed => L("失败", "Failed"),
        _ => status.ToString(),
    };
}

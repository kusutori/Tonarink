@page "/history"
@inherits StatefulComponentBase

<PageTitle>@T("History") · Tonarink</PageTitle>
<div class="page">
    <header class="page-header">
        <div><h1>@T("History")</h1><p>@T("HistoryDescription")</p></div>
        <FluentButton Appearance="ButtonAppearance.Outline" Href="/" IconStart="@(new Icons.Regular.Size20.ArrowLeft())">@T("BackToReceive")</FluentButton>
    </header>
    <AppCard>
        @if (AppState.Transfers.Count == 0)
        {
            <EmptyState Title="@T("NoTransfers")" Description="@T("NoTransfersHint")"><Icon><FluentIcon Value="@(new Icons.Regular.Size32.History())" /></Icon></EmptyState>
        }
        else
        {
            <div class="list-stack history-list">
                @foreach (var transfer in AppState.Transfers)
                {
                    <div class="row-item transfer-row">
                        <span class="file-icon"><FluentIcon Value="@TransferIcon(transfer.Direction)" /></span>
                        <span>
                            <strong>@transfer.PeerAlias</strong>
                            <small>@transfer.Summary · @StatusText(transfer.Status)</small>
                            <FluentProgressBar Value="@((int)(transfer.Progress * 100))" Min="0" Max="100" />
                        </span>
                        <time>@transfer.UpdatedAt.ToLocalTime().ToString("g")</time>
                    </div>
                }
            </div>
        }
    </AppCard>
</div>

@code {
    private static Icon TransferIcon(TransferDirection direction) => direction == TransferDirection.Send
        ? new Icons.Regular.Size20.ArrowUpload()
        : new Icons.Regular.Size20.ArrowDownload();
    private string StatusText(TransferStatus status) => status switch
    {
        TransferStatus.Waiting => T("StatusWaiting"),
        TransferStatus.Transferring => T("StatusTransferring"),
        TransferStatus.Completed => T("StatusCompleted"),
        TransferStatus.Cancelled => T("StatusCancelled"),
        TransferStatus.Failed => T("StatusFailed"),
        _ => status.ToString(),
    };
}

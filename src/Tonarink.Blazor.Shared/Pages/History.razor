@page "/history"
@inherits StatefulComponentBase

<PageTitle>@L("历史", "History") · Tonarink</PageTitle>

<div class="page">
    <header class="page-header">
        <div>
            <h1>@L("历史", "History")</h1>
            <p>@L("当前会话中的发送和接收活动。", "Send and receive activity from this session.")</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Href="/">@L("返回接收", "Back to receive")</BbButton>
    </header>

    <BbCard>
        <BbCardContent>
            @if (AppState.Transfers.Count == 0)
            {
                <BbEmpty Title="@L("暂无传输记录", "No transfers yet")" Description="@L("完成一次发送或接收后会显示在这里。", "Completed sends and receives will appear here.")">
                    <Icon><LucideIcon Name="history" /></Icon>
                </BbEmpty>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var transfer in AppState.Transfers)
                    {
                        <div class="row-item">
                            <LucideIcon Name="@(transfer.Direction == TransferDirection.Send ? "arrow-up" : "arrow-down")" Class="h-4 w-4" />
                            <div>
                                <strong>@transfer.PeerAlias</strong>
                                <small>@transfer.Summary · @StatusText(transfer.Status)</small>
                                <BbProgress Value="@(transfer.Progress * 100)" />
                            </div>
                            <time class="text-xs text-muted-foreground">@transfer.UpdatedAt.ToLocalTime().ToString("g")</time>
                        </div>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    private string StatusText(TransferStatus status) => status switch
    {
        TransferStatus.Waiting => L("等待中", "Waiting"),
        TransferStatus.Transferring => L("传输中", "Transferring"),
        TransferStatus.Completed => L("已完成", "Completed"),
        TransferStatus.Cancelled => L("已取消", "Cancelled"),
        TransferStatus.Failed => L("失败", "Failed"),
        _ => status.ToString(),
    };
}

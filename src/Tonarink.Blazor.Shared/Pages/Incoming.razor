@page "/receive/{Id}"
@inherits StatefulComponentBase
@inject ITonarinkRuntime Runtime
@inject NavigationManager Navigation
@inject IPlatformServices Platform
@inject IJSRuntime JS

<PageTitle>@T("IncomingRequest") · Tonarink</PageTitle>

<div class="page incoming-page">
    @if (Offer is null)
    {
        <EmptyState Title="@T("RequestExpired")" Description="@T("RequestExpiredDescription")">
            <Icon><FluentIcon Value="@(new Icons.Regular.Size32.Alert())" /></Icon>
            <ChildContent>
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="BackToReceive">@T("BackToReceive")</FluentButton>
            </ChildContent>
        </EmptyState>
    }
    else
    {
        <header class="page-header">
            <div>
                <h1>@Offer.SenderAlias</h1>
                <p>@T("WantsToSend", Offer.SenderModel, Offer.Items.Count)</p>
            </div>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ToggleAll">
                @(_selected.Count == Offer.Items.Count ? T("SelectNone") : T("SelectAll"))
            </FluentButton>
        </header>

        @if (_error is not null)
        {
            <StatusMessage Intent="error" Title="@T("CouldNotComplete")">
                <Icon><FluentIcon Value="@(new Icons.Regular.Size20.ErrorCircle())" /></Icon>
                <ChildContent>@_error</ChildContent>
            </StatusMessage>
        }

        <AppCard Title="@T("ChooseWhatToReceive")">
            <ChildContent>
                <div class="list-stack incoming-list">
                    @foreach (var item in Offer.Items)
                    {
                        var selected = _selected.Contains(item.Id);
                        <button type="button" class="row-item interactive selectable @(selected ? "selected" : null)" @onclick="() => Toggle(item.Id)" aria-pressed="@selected">
                            @if (selected)
                            {
                                <FluentIcon Value="@(new Icons.Filled.Size20.CheckboxChecked())" />
                            }
                            else
                            {
                                <FluentIcon Value="@(new Icons.Regular.Size20.CheckboxUnchecked())" />
                            }
                            <span>
                                <strong>@item.Name</strong>
                                <small>@item.ContentType · @FormatBytes(item.Size)</small>
                            </span>
                            <FluentIcon Value="@IncomingItemIcon(item)" />
                        </button>
                        @if (item.TextContent is { } text)
                        {
                            <section class="text-preview" aria-label="@item.Name">
                                <pre>@text</pre>
                                <FluentButton Appearance="ButtonAppearance.Outline" IconStart="@(new Icons.Regular.Size20.Copy())" OnClick="() => CopyTextAsync(text)">@T("Copy")</FluentButton>
                            </section>
                        }
                    }
                </div>
            </ChildContent>
        </AppCard>

        <footer class="decision-bar">
            @if (_receiveCancellation is not null)
            {
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="CancelReceive">@T("CancelReceive")</FluentButton>
            }
            <FluentButton Appearance="ButtonAppearance.Outline" Class="danger-button" IconStart="@(new Icons.Regular.Size20.Dismiss())" OnClick="DeclineAsync" Disabled="@_busy">@T("Decline")</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Checkmark())" OnClick="AcceptAsync" Disabled="@(_busy || _selected.Count == 0)">
                @if (_busy)
                {
                    <FluentSpinner aria-label="@T("Receiving")" />
                }
                else
                {
                    @T("ReceiveNItems", _selected.Count)
                }
            </FluentButton>
        </footer>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private readonly HashSet<Guid> _selected = [];
    private string? _initializedOfferId;
    private bool _busy;
    private string? _error;
    private CancellationTokenSource? _receiveCancellation;
    private IncomingOffer? Offer => AppState.IncomingOffers.FirstOrDefault(item => StringComparer.Ordinal.Equals(item.Id, Id));

    protected override void OnParametersSet()
    {
        if (Offer is not { } offer || StringComparer.Ordinal.Equals(_initializedOfferId, offer.Id))
            return;

        _selected.Clear();
        _selected.UnionWith(offer.Items.Select(static item => item.Id));
        _initializedOfferId = offer.Id;
    }

    private void Toggle(Guid id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAll()
    {
        if (Offer is not { } offer)
            return;

        if (_selected.Count == offer.Items.Count)
            _selected.Clear();
        else
            _selected.UnionWith(offer.Items.Select(static item => item.Id));
    }

    private async Task AcceptAsync()
    {
        _receiveCancellation = new CancellationTokenSource();
        await DecideAsync(offer => Runtime.AcceptAsync(offer, _selected, _receiveCancellation.Token));
        _receiveCancellation.Dispose();
        _receiveCancellation = null;
    }

    private Task DeclineAsync() => DecideAsync(offer => Runtime.DeclineAsync(offer));
    private void BackToReceive() => Navigation.NavigateTo("/");
    private void CancelReceive() => _receiveCancellation?.Cancel();

    private async Task DecideAsync(Func<IncomingOffer, Task> action)
    {
        if (Offer is not { } offer)
            return;

        _busy = true;
        _error = null;
        try
        {
            await action(offer);
            Navigation.NavigateTo("/");
        }
        catch (OperationCanceledException) when (_receiveCancellation?.IsCancellationRequested is true)
        {
            _error = T("TransferCanceled");
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyTextAsync(string text)
    {
        try
        {
            if (Platform.Capabilities.IsNative)
                await Platform.WriteClipboardTextAsync(text);
            else
                await JS.InvokeVoidAsync("tonarink.writeClipboard", text);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private static Icon IncomingItemIcon(ShareItem item) => item.TextContent is null
        ? new Icons.Regular.Size20.Document()
        : new Icons.Regular.Size20.DocumentText();
}

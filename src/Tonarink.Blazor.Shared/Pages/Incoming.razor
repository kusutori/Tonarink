@page "/receive/{Id}"
@inherits StatefulComponentBase
@inject ITonarinkRuntime Runtime
@inject NavigationManager Navigation
@inject IPlatformServices Platform
@inject IJSRuntime JS

<PageTitle>@T("IncomingRequest") · Tonarink</PageTitle>

<div class="page">
    @if (Offer is null)
    {
        <BbEmpty Title="@T("RequestExpired")" Description="@T("RequestExpiredDescription")">
            <Icon><LucideIcon Name="circle-alert" /></Icon>
            <ChildContent>
                <BbButton Href="/">@T("BackToReceive")</BbButton>
            </ChildContent>
        </BbEmpty>
    }
    else
    {
        <header class="page-header">
            <div>
                <h1>@Offer.SenderAlias</h1>
                <p>@T("WantsToSend", Offer.SenderModel, Offer.Items.Count)</p>
            </div>
            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ToggleAll">
                @(_selected.Count == Offer.Items.Count ? T("SelectNone") : T("SelectAll"))
            </BbButton>
        </header>

        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                <BbAlertTitle>@T("CouldNotComplete")</BbAlertTitle>
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@T("ChooseWhatToReceive")</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <div class="list-stack">
                    @foreach (var item in Offer.Items)
                    {
                        var selected = _selected.Contains(item.Id);
                        <BbButton Variant="ButtonVariant.Outline" Class="row-item h-auto py-3" OnClick="() => Toggle(item.Id)">
                            <LucideIcon Name="@(selected ? "square-check" : "square")" Class="h-4 w-4" />
                            <div>
                                <strong>@item.Name</strong>
                                <small>@item.ContentType · @FormatBytes(item.Size)</small>
                            </div>
                            <LucideIcon Name="@(item.TextContent is null ? "file" : "file-text")" Class="h-4 w-4" />
                        </BbButton>
                        @if (item.TextContent is { } text)
                        {
                            <BbCard>
                                <BbCardContent>
                                    <pre class="text-sm whitespace-pre-wrap">@text</pre>
                                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => CopyTextAsync(text)">@T("Copy")</BbButton>
                                </BbCardContent>
                            </BbCard>
                        }
                    }
                </div>
            </BbCardContent>
        </BbCard>

        <footer class="decision-bar">
            @if (_receiveCancellation is not null)
            {
                <BbButton Variant="ButtonVariant.Outline" OnClick="CancelReceive">@T("CancelReceive")</BbButton>
            }
            <BbButton Variant="ButtonVariant.Destructive" OnClick="DeclineAsync" Disabled="@_busy">@T("Decline")</BbButton>
            <BbButton OnClick="AcceptAsync" Disabled="@(_busy || _selected.Count == 0)">@T("ReceiveNItems", _selected.Count)</BbButton>
        </footer>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private readonly HashSet<Guid> _selected = [];
    private bool _initialized;
    private bool _busy;
    private string? _error;
    private CancellationTokenSource? _receiveCancellation;
    private IncomingOffer? Offer => AppState.IncomingOffers.FirstOrDefault(item => StringComparer.Ordinal.Equals(item.Id, Id));

    protected override void OnParametersSet()
    {
        if (!_initialized && Offer is { } offer)
        {
            _selected.UnionWith(offer.Items.Select(static item => item.Id));
            _initialized = true;
        }
    }

    private void Toggle(Guid id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAll()
    {
        if (Offer is not { } offer) return;
        if (_selected.Count == offer.Items.Count) _selected.Clear(); else _selected.UnionWith(offer.Items.Select(static item => item.Id));
    }

    private async Task AcceptAsync()
    {
        _receiveCancellation = new CancellationTokenSource();
        await DecideAsync(offer => Runtime.AcceptAsync(offer, _selected, _receiveCancellation.Token));
        _receiveCancellation.Dispose();
        _receiveCancellation = null;
    }
    private async Task DeclineAsync() => await DecideAsync(offer => Runtime.DeclineAsync(offer));
    private void CancelReceive() => _receiveCancellation?.Cancel();
    private async Task DecideAsync(Func<IncomingOffer, Task> action)
    {
        if (Offer is not { } offer) return;
        _busy = true; _error = null;
        try { await action(offer); Navigation.NavigateTo("/"); }
        catch (Exception exception) { _error = exception.Message; }
        finally { _busy = false; }
    }

    private async Task CopyTextAsync(string text)
    {
        if (Platform.Capabilities.IsNative)
            await Platform.WriteClipboardTextAsync(text);
        else
            await JS.InvokeVoidAsync("tonarink.writeClipboard", text);
    }
}

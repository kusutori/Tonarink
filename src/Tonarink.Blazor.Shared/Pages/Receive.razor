@page "/"
@inherits StatefulComponentBase

<PageTitle>@T("Receive") · Tonarink</PageTitle>

<div class="page">
    <header class="page-header">
        <div>
            <h1>@AppState.Settings.Alias</h1>
            <p>@T("ReceiveDescription")</p>
        </div>
        <BbBadge Variant="@(AppState.RuntimeRunning ? BadgeVariant.Default : BadgeVariant.Secondary)">
            @(AppState.RuntimeRunning ? T("ReadyToReceive") : T("NotConnected"))
        </BbBadge>
    </header>

    @if (!AppState.Platform.Capabilities.CanRunLocalSendNode)
    {
        <BbAlert Variant="AlertVariant.Warning" AccentBorder>
            <Icon><LucideIcon Name="info" Class="h-4 w-4" /></Icon>
            <ChildContent>
                <BbAlertTitle>@T("BrowserLimitationsTitle")</BbAlertTitle>
                <BbAlertDescription>@T("BrowserLimitationsDescription")</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }
    else if (AppState.RuntimeError is { } runtimeError)
    {
        <BbAlert Variant="AlertVariant.Danger" AccentBorder>
            <Icon><LucideIcon Name="circle-alert" Class="h-4 w-4" /></Icon>
            <ChildContent>
                <BbAlertTitle>@T("NodeStartFailed")</BbAlertTitle>
                <BbAlertDescription>@runtimeError</BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@T("WaitingNearby")</BbCardTitle>
            <BbCardDescription>@T("AdvertisedAs", AppState.Settings.Alias)</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <div class="settings-row" style="border:0;padding:0">
                <div>
                    <strong>@T("AutoAccept")</strong>
                    <small>@T("AutoAcceptDescription")</small>
                </div>
                <BbSwitch Checked="@AppState.Settings.AutoAccept" CheckedChanged="ToggleAutoAccept" AriaLabel="@T("AutoAccept")" />
            </div>
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@T("IncomingRequests")</BbCardTitle>
            <BbCardDescription>@T("IncomingRequestsDescription")</BbCardDescription>
            <BbCardAction>
                <BbBadge Variant="BadgeVariant.Secondary">@AppState.IncomingOffers.Count</BbBadge>
            </BbCardAction>
        </BbCardHeader>
        <BbCardContent>
            @if (AppState.IncomingOffers.Count == 0)
            {
                <BbEmpty Title="@T("NoPendingRequests")"
                         Description="@T("PendingRequestsHint")"
                         Size="EmptySize.Small">
                    <Icon><LucideIcon Name="inbox" /></Icon>
                </BbEmpty>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var offer in AppState.IncomingOffers)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Class="row-item h-auto py-3" Href="@($"/receive/{offer.Id}")">
                            <BbAvatar Size="AvatarSize.Small"><BbAvatarFallback>@DeviceInitial(offer.SenderAlias)</BbAvatarFallback></BbAvatar>
                            <div>
                                <strong>@offer.SenderAlias</strong>
                                <small>@offer.SenderModel · @offer.Items.Count @T("Items")</small>
                            </div>
                            <LucideIcon Name="chevron-right" Class="h-4 w-4" />
                        </BbButton>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@T("RecentActivity")</BbCardTitle>
            <BbCardDescription>@T("RecentActivityDescription")</BbCardDescription>
            <BbCardAction>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="/history">@T("ViewAll")</BbButton>
            </BbCardAction>
        </BbCardHeader>
        <BbCardContent>
            @if (AppState.Transfers.Count == 0)
            {
                <BbEmpty Title="@T("NoTransfers")" Size="EmptySize.Small">
                    <Icon><LucideIcon Name="history" /></Icon>
                </BbEmpty>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var transfer in AppState.Transfers.Take(5))
                    {
                        <div class="row-item">
                            <LucideIcon Name="@(transfer.Direction == TransferDirection.Send ? "arrow-up" : "arrow-down")" Class="h-4 w-4" />
                            <div>
                                <strong>@transfer.PeerAlias</strong>
                                <small>@transfer.Summary</small>
                            </div>
                            <BbBadge Variant="BadgeVariant.Outline">@transfer.Status</BbBadge>
                        </div>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    private Task ToggleAutoAccept(bool enabled) =>
        AppState.UpdateSettingsAsync(settings => settings with { AutoAccept = enabled });

    private static string DeviceInitial(string alias) => string.IsNullOrWhiteSpace(alias) ? "?" : alias[..1].ToUpperInvariant();
}

@page "/"
@inherits StatefulComponentBase

<PageTitle>@T("Receive") · Tonarink</PageTitle>
<div class="page">
    <header class="page-header">
        <div><h1>@T("Receive")</h1><p>@T("ReceiveDescription")</p></div>
        <FluentBadge Appearance="@(AppState.RuntimeRunning ? BadgeAppearance.Filled : BadgeAppearance.Outline)" Color="@(AppState.RuntimeRunning ? BadgeColor.Success : BadgeColor.Informative)">
            @(AppState.RuntimeRunning ? T("ReadyToReceive") : T("NotConnected"))
        </FluentBadge>
    </header>

    @if (!AppState.Platform.Capabilities.CanRunLocalSendNode)
    {
        <StatusMessage Intent="warning" Title="@T("BrowserLimitationsTitle")">
            <Icon><FluentIcon Value="@(new Icons.Regular.Size20.Info())" /></Icon>
            <ChildContent>@T("BrowserLimitationsDescription")</ChildContent>
        </StatusMessage>
    }
    else if (AppState.RuntimeError is { } runtimeError)
    {
        <StatusMessage Intent="error" Title="@T("NodeStartFailed")">
            <Icon><FluentIcon Value="@(new Icons.Regular.Size20.ErrorCircle())" /></Icon>
            <ChildContent>@runtimeError</ChildContent>
        </StatusMessage>
    }

    <section class="receive-hero">
        <div class="device-avatar"><FluentIcon Value="@(new Icons.Regular.Size32.Desktop())" /></div>
        <h2>@AppState.Settings.Alias</h2>
        <p>@T("AdvertisedAs", AppState.Settings.Alias)</p>
    </section>

    <AppCard Title="@T("WaitingNearby")" Description="@T("IncomingRequestsDescription")">
        <div class="settings-row compact">
            <div><strong>@T("AutoAccept")</strong><small>@T("AutoAcceptDescription")</small></div>
            <FluentSwitch Value="@AppState.Settings.AutoAccept" ValueChanged="ToggleAutoAccept" aria-label="@T("AutoAccept")" />
        </div>
    </AppCard>

    <div class="dashboard-grid">
        <AppCard Title="@T("IncomingRequests")" Description="@T("IncomingRequestsDescription")">
            <HeaderAction><FluentBadge Appearance="BadgeAppearance.Tint">@AppState.IncomingOffers.Count</FluentBadge></HeaderAction>
            <ChildContent>
            @if (AppState.IncomingOffers.Count == 0)
            {
                <EmptyState Title="@T("NoPendingRequests")" Description="@T("PendingRequestsHint")">
                    <Icon><FluentIcon Value="@(new Icons.Regular.Size32.MailInbox())" /></Icon>
                </EmptyState>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var offer in AppState.IncomingOffers)
                    {
                        <a class="row-item interactive" href="@($"/receive/{offer.Id}")">
                            <span class="initial-avatar">@DeviceInitial(offer.SenderAlias)</span>
                            <span><strong>@offer.SenderAlias</strong><small>@offer.SenderModel · @offer.Items.Count @T("Items")</small></span>
                            <FluentIcon Value="@(new Icons.Regular.Size20.ChevronRight())" />
                        </a>
                    }
                </div>
            }
            </ChildContent>
        </AppCard>

        <AppCard Title="@T("RecentActivity")" Description="@T("RecentActivityDescription")">
            <HeaderAction><FluentButton Appearance="ButtonAppearance.Subtle" Href="/history">@T("ViewAll")</FluentButton></HeaderAction>
            <ChildContent>
            @if (AppState.Transfers.Count == 0)
            {
                <EmptyState Title="@T("NoTransfers")"><Icon><FluentIcon Value="@(new Icons.Regular.Size32.History())" /></Icon></EmptyState>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var transfer in AppState.Transfers.Take(5))
                    {
                        <div class="row-item">
                            <FluentIcon Value="@TransferIcon(transfer.Direction)" />
                            <span><strong>@transfer.PeerAlias</strong><small>@transfer.Summary</small></span>
                            <FluentBadge Appearance="BadgeAppearance.Outline">@transfer.Status</FluentBadge>
                        </div>
                    }
                </div>
            }
            </ChildContent>
        </AppCard>
    </div>
</div>

@code {
    private static Icon TransferIcon(TransferDirection direction) => direction == TransferDirection.Send
        ? new Icons.Regular.Size20.ArrowUpload()
        : new Icons.Regular.Size20.ArrowDownload();
    private Task ToggleAutoAccept(bool enabled) => AppState.UpdateSettingsAsync(settings => settings with { AutoAccept = enabled });
    private static string DeviceInitial(string alias) => string.IsNullOrWhiteSpace(alias) ? "?" : alias[..1].ToUpperInvariant();
}

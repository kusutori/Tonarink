<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Exhaustive enum switches intentionally reject unnamed numeric values at runtime.
         Keep CS8509 enabled so adding a named member still breaks incomplete switches. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
    <!-- Pin the rule baseline; review changes when upgrading global.json. -->
    <AnalysisLevel>11.0</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <LangVersion>preview</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
